{
  "manifest_version": 3,
  "name": "Teletalk AutoFill",
  "version": "3.5",
  "description": "Teletalk Autofill",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],

  "host_permissions": [
    "*://*.teletalk.com.bd/*"
  ],

  "web_accessible_resources": [
    {
      "resources": [
    "profiles.json",
    "profiles/*.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "icons": {
    "128": "icon.png"
  }
}