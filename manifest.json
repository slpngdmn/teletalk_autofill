{
  "manifest_version": 3,
  "name": "BD Govt Job Autofill",
  "version": "5.0",
  "description": "Create profiles and auto-fill Teletalk Govt job applications.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "scripting", "downloads"],

  "host_permissions": ["*://*.teletalk.com.bd/*"],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "128": "icon.png"
  }
}
